# Copy to `.env` and fill in Spotify credentials:
#   cp .env.example .env
#
# Local stack from repo root:
#   docker compose up -d --build
#
# Volume paths for docker-compose.yml (host paths):
SPOOTY_DOWNLOADS_DIR=./downloads
SPOOTY_COOKIES_FILE=${HOME}/Downloads/www.youtube.com_cookies.txt

SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_AUTH_SCOPES=playlist-read-private playlist-read-collaborative

DB_PATH=./config/db.sqlite
FE_PATH=../frontend/browser
DOWNLOADS_PATH=./downloads

FORMAT=mp3
PORT=3000

REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_RUN=true

YT_COOKIES=
YT_COOKIES_FILE=/spooty/config/cookies.txt
YT_DOWNLOADS_PER_MINUTE=3
YT_DLP_SLEEP_INTERVAL=5
YT_DLP_RETRIES=3
